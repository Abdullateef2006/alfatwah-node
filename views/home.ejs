<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Explore Al-Fatwa Islamic Teachings: A comprehensive library of lectures and Q&A episodes by Sheikh Dhikrullah Shafi'i.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css">
    <title>Home - Al-Fatwa</title>
</head>
<body>
    <%- include('partials/header') %>

    <%
    const truncateWords = (text, maxWords = 80) => {
        if (!text) return '';
        const words = text.trim().split(/\s+/);
        if (words.length <= maxWords) return text;
        return words.slice(0, maxWords).join(' ') + '...';
    };
    %>

    <main class="main-content">
        <div class="hero animate-in">
            <div class="container">
                <span class="section-label">A Legacy of Knowledge</span>
                <h1>Seek Wisdom. <br>Embrace Excellence.</h1>
                <p>Join a global community dedicated to authentic Islamic scholarship and spiritual growth. Led by Sheikh Dhikrullah Shafi'i.</p>
                
                <form action="/search/" method="POST" class="search-container animate-in" style="animation-delay: 0.2s;">
                    <input type="text" name="search" class="search-input" placeholder="Search for lectures, topics, or fatwas..." required>
                    <button type="submit" class="btn btn-primary" style="padding: 0.8rem 2.2rem; display: flex; align-items: center; gap: 0.75rem;">
                        <i class="fa-solid fa-magnifying-glass" style="font-size: 0.9rem;"></i>
                        <span>Search Now</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="container">
            <% if (!query) { %>
            <div class="card-grid" style="margin-top: -6rem; margin-bottom: 10rem;">
                <!-- Bento Card: Continue Reading -->
                <div class="course-card bento-large animate-in" style="padding: 3rem;" id="resume-card">
                    <span class="section-label">Resume Learning</span>
                    <h2 class="card-title" style="font-size: 1.8rem;" id="resume-lecture-title">Principles of Islamic Jurisprudence</h2>
                    <p class="card-desc" style="font-size: 1.05rem;" id="resume-episode-title">Start learning with our scholarly series and lectures.</p>
                    <div style="margin-top: 2.5rem;">
                        <a href="/list/" style="color: var(--primary); font-weight: 700; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;" id="resume-link">
                            Explore Library <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Bento Card: Prayer Times -->
                <div class="course-card animate-in" style="padding: 3rem;" id="prayer-card">
                    <span class="section-label">Spiritual Pulse</span>
                    <h2 class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Prayer Times</span>
                        <small id="prayer-location" style="font-size: 0.55em; color: var(--text-muted); font-weight: normal; text-transform: none;"></small>
                    </h2>
                    <div style="margin-top: 1.5rem;" id="prayer-times-list">
                        <div style="text-align: center; padding: 1.5rem 0; color: var(--text-muted);">
                            <i class="fa-solid fa-circle-notch fa-spin"></i> Loading timings...
                        </div>
                    </div>
                </div>

                <!-- Bento Card: Live Lessons -->
                <a href="https://www.facebook.com/" target="_blank" class="course-card animate-in" style="padding: 3rem; display: block; border-color: var(--border-glass);">
                    <span class="section-label">Live Learning</span>
                    <h2 class="card-title">Live Fatwah Sessions</h2>
                    <p class="card-desc">Every Wednesday at 8:30 PM. Live Fatwah sessions with Fadeelatu-Sheikh Dhikrullah Shafi'i on Facebook.</p>
                    <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--accent); font-weight: 800; font-size: 0.9rem; text-transform: uppercase;">Wednesdays, 8:30 PM</span>
                        <span style="color: var(--primary); font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem;">Join Live <i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                    </div>
                </a>
            </div>
            <% } %>

            <% if (query) { %>
            <div style="margin-bottom: 8rem;">
                <span class="section-label">Search Results</span>
                <h2 style="font-size: 2.5rem; margin-bottom: 4rem;">Results for "<%= query %>"</h2>
                <div class="card-grid">
                    <% lectures.forEach(function(lecture, index) { %>
                    <a href="/lecture/<%= lecture.id %>/" class="course-card animate-in" style="animation-delay: <%= index * 0.1 %>s">
                        <div class="card-image-wrapper">
                            <% if (lecture.imgUrl) { %>
                            <img src="<%= lecture.imgUrl %>" alt="<%= lecture.title %>">
                            <% } else { %>
                            <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="<%= lecture.title %>">
                            <% } %>
                        </div>
                        <h3 class="card-title"><%= lecture.title %></h3>
                        <p class="card-desc"><%= truncateWords(lecture.description) %></p>
                    </a>
                    <% }); %>
                </div>
            </div>
            <% } else { %>
            <div style="margin-bottom: 5rem; text-align: center;">
                <span class="section-label">Explore the Library</span>
                <h2 style="font-size: 3rem; margin-bottom: 4rem;">Scholarly Series</h2>
            </div>
            
            <% if (lectures.length === 0) { %>
            <div class="card-grid" style="margin-bottom: 10rem;">
                <!-- Dummy Card 1 -->
                <a href="/list/" class="course-card animate-in">
                    <div class="card-image-wrapper">
                        <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="Coming Soon">
                    </div>
                    <h3 class="card-title">Principles of Islamic Jurisprudence</h3>
                    <p class="card-desc">An upcoming deep-dive into the foundational rules of Fiqh and their applications in modern times.</p>
                    <div style="margin-top: 2rem; color: var(--accent); font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Coming Soon</div>
                </a>
                <!-- Dummy Card 2 -->
                <a href="/list/" class="course-card animate-in" style="animation-delay: 0.1s;">
                    <div class="card-image-wrapper">
                        <img src="/static/img/4ca1c577-6480-4cfa-a4fc-4729f8ca835c.png" alt="Coming Soon">
                    </div>
                    <h3 class="card-title">The Prophetic Biography</h3>
                    <p class="card-desc">Exploring the life and character of Prophet Muhammad (PBUH) as a guide for character development.</p>
                    <div style="margin-top: 2rem; color: var(--accent); font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Coming Soon</div>
                </a>
                <!-- Dummy Card 3 -->
                <a href="/list/" class="course-card animate-in" style="animation-delay: 0.2s;">
                    <div class="card-image-wrapper">
                        <img src="/static/img/6407d2d5-bceb-487a-b248-93cf95952b99.png" alt="Coming Soon">
                    </div>
                    <h3 class="card-title">Purification of the Heart</h3>
                    <p class="card-desc">A series focused on Tazkiyah, spirituality, and achieving inner peace through faith.</p>
                    <div style="margin-top: 2rem; color: var(--accent); font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">Coming Soon</div>
                </a>
            </div>
            <% } else { %>
            <div class="card-grid" style="margin-bottom: 10rem;">
                <% lectures.forEach(function(lecture, index) { %>
                <a href="/lecture/<%= lecture.id %>/" class="course-card animate-in" style="animation-delay: <%= index * 0.1 %>s">
                    <div class="card-image-wrapper">
                        <% if (lecture.imgUrl) { %>
                        <img src="<%= lecture.imgUrl %>" alt="<%= lecture.title %>">
                        <% } else { %>
                        <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="<%= lecture.title %>">
                        <% } %>
                    </div>
                    <h3 class="card-title"><%= lecture.title %></h3>
                    <p class="card-desc"><%= truncateWords(lecture.description) %></p>
                </a>
                <% }); %>
            </div>
            <% } %>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // ----------------------------------------------------
            // 1. Resume Learning Logic (from LocalStorage)
            // ----------------------------------------------------
            try {
                const dataStr = localStorage.getItem('lastLearnedEpisode');
                if (dataStr) {
                    const lastLearned = JSON.parse(dataStr);
                    if (lastLearned && lastLearned.url) {
                        const titleEl = document.getElementById('resume-lecture-title');
                        const descEl = document.getElementById('resume-episode-title');
                        const linkEl = document.getElementById('resume-link');

                        titleEl.textContent = lastLearned.lectureTitle || 'Islamic Teachings';
                        descEl.textContent = `Continue where you left off: ${lastLearned.title}`;
                        linkEl.innerHTML = `Continue Reading <i class="fa-solid fa-arrow-right"></i>`;
                        linkEl.setAttribute('href', lastLearned.url);
                    }
                }
            } catch (e) {
                console.error('Failed to load learning progress:', e);
            }

            // ----------------------------------------------------
            // 2. Automated Prayer Times (Aladhan API)
            // ----------------------------------------------------
            const prayerList = document.getElementById('prayer-times-list');
            const prayerLocation = document.getElementById('prayer-location');

            const formatTime12h = (time24) => {
                if (!time24) return '';
                const parts = time24.split(' ')[0].split(':');
                let hours = parseInt(parts[0], 10);
                const minutes = parts[1];
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12;
                hours = hours ? hours : 12; // 0 should be 12
                return `${hours}:${minutes} ${ampm}`;
            };

            const renderPrayerTimes = (timings, city) => {
                const prayers = [
                    { name: 'Fajr', key: 'Fajr' },
                    { name: 'Dhuhr', key: 'Dhuhr' },
                    { name: 'Asr', key: 'Asr' },
                    { name: 'Maghrib', key: 'Maghrib' },
                    { name: 'Isha', key: 'Isha' }
                ];

                prayerLocation.textContent = `(${city})`;

                const now = new Date();
                const currentMinutes = now.getHours() * 60 + now.getMinutes();

                let nextPrayerIndex = -1;
                let minDiff = Infinity;

                const prayerTimesParsed = prayers.map(p => {
                    const timeStr = timings[p.key].split(' ')[0];
                    const parts = timeStr.split(':');
                    const pMinutes = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
                    return { ...p, minutes: pMinutes, formatted: formatTime12h(timings[p.key]) };
                });

                prayerTimesParsed.forEach((p, idx) => {
                    const diff = p.minutes - currentMinutes;
                    if (diff > 0 && diff < minDiff) {
                        minDiff = diff;
                        nextPrayerIndex = idx;
                    }
                });

                if (nextPrayerIndex === -1) {
                    nextPrayerIndex = 0; // Next prayer is Fajr tomorrow
                }

                prayerList.innerHTML = prayerTimesParsed.map((p, idx) => {
                    const isNext = idx === nextPrayerIndex;
                    const borderStyle = idx === prayerTimesParsed.length - 1 ? '' : 'border-bottom: 1px solid var(--border-glass);';
                    const colorClass = isNext ? 'color: var(--primary); font-weight: 700;' : 'color: var(--text-primary);';
                    const nextBadge = isNext ? '<span style="background: rgba(5, 150, 105, 0.15); color: var(--primary); font-size: 0.65rem; padding: 0.2rem 0.5rem; border-radius: 99px; margin-left: 0.5rem; vertical-align: middle; font-family: \'Inter\', sans-serif;">Next</span>' : '';
                    return `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; ${borderStyle} ${colorClass}">
                            <span style="font-weight: 500; display: flex; align-items: center;">${p.name}${nextBadge}</span> 
                            <span style="font-weight: 700;">${p.formatted}</span>
                        </div>
                    `;
                }).join('');
            };

            const fetchPrayerTimes = () => {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        async (position) => {
                            try {
                                const lat = position.coords.latitude;
                                const lon = position.coords.longitude;
                                const res = await fetch(`https://api.aladhan.com/v1/timings?latitude=${lat}&longitude=${lon}&method=3`);
                                const data = await res.json();
                                if (data && data.data && data.data.timings) {
                                    renderPrayerTimes(data.data.timings, 'Your Location');
                                } else {
                                    throw new Error('API Error');
                                }
                            } catch (err) {
                                fetchFallback();
                            }
                        },
                        () => {
                            fetchFallback();
                        }
                    );
                } else {
                    fetchFallback();
                }
            };

            const fetchFallback = async () => {
                try {
                    const res = await fetch('https://api.aladhan.com/v1/timingsByCity?city=Lagos&country=Nigeria&method=3');
                    const data = await res.json();
                    if (data && data.data && data.data.timings) {
                        renderPrayerTimes(data.data.timings, 'Lagos, NG');
                    } else {
                        throw new Error('Fallback Error');
                    }
                } catch (err) {
                    prayerList.innerHTML = `<div style="color: var(--text-muted); text-align: center; padding: 1rem;">Unable to load timings.</div>`;
                }
            };

            fetchPrayerTimes();
        });
    </script>
</body>
</html>