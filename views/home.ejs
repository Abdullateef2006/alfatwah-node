<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Explore Al-Fatwa Islamic Teachings: A comprehensive library of lectures and Q&A episodes by Sheikh Dhikrullah Shafi'i.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css">
    <title>Home - Al-Fatwa</title>
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <div class="hero animate-in">
            <div class="container">
                <span class="section-label">A Legacy of Knowledge</span>
                <h1>Seek Wisdom. <br>Embrace Excellence.</h1>
                <p>Join a global community dedicated to authentic Islamic scholarship and spiritual growth. Led by Sheikh Dhikrullah Shafi'i.</p>
                
                <form action="/search/" method="POST" class="search-container animate-in" style="animation-delay: 0.2s;">
                    <input type="text" name="search" class="search-input" placeholder="Search for lectures, topics, or fatwas..." required>
                    <button type="submit" class="btn btn-primary" style="padding: 0.8rem 2.2rem; display: flex; align-items: center; gap: 0.75rem;">
                        <i class="fa-solid fa-magnifying-glass" style="font-size: 0.9rem;"></i>
                        <span>Search Now</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="container">
            <div class="card-grid" style="margin-top: -6rem; margin-bottom: 10rem;">
                <!-- Bento Card: Continue Reading -->
                <div class="course-card animate-in" style="grid-column: span 2; padding: 3rem;">
                    <span class="section-label">Resume Learning</span>
                    <h2 class="card-title" style="font-size: 1.8rem;">Jurisprudence of Modern Life</h2>
                    <p class="card-desc" style="font-size: 1.05rem;">Continue where you left off in Chapter 4: Ethics of Digital Interaction.</p>
                    <div style="margin-top: 2.5rem;">
                        <a href="#" style="color: var(--primary); font-weight: 700; display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;">
                            Continue Reading <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Bento Card: Prayer Times -->
                <div class="course-card animate-in" style="padding: 3rem;">
                    <span class="section-label">Spiritual Pulse</span>
                    <h2 class="card-title">Prayer Times</h2>
                    <div style="margin-top: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border-glass);">
                            <span style="font-weight: 500; color: var(--text-secondary);">Fajr</span> 
                            <span style="font-weight: 700; color: var(--primary);">05:12 AM</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 1rem 0; color: var(--primary);">
                            <span style="font-weight: 700;">Dhuhr</span> 
                            <span style="font-weight: 800; font-size: 1.1rem;">12:45 PM</span>
                        </div>
                    </div>
                </div>

                <!-- Bento Card: Upcoming Lessons -->
                <div class="course-card animate-in" style="padding: 3rem;">
                    <span class="section-label">Live Learning</span>
                    <h2 class="card-title">Live Lessons</h2>
                    <p class="card-desc">Next: Tafsir of Surah Al-Kahf with Sheikh Shafi'i.</p>
                    <span style="display: block; margin-top: 1.5rem; color: var(--accent); font-weight: 800; font-size: 0.9rem; text-transform: uppercase;">Today, 8:00 PM</span>
                </div>
            </div>

            <% if (query) { %>
            <div style="margin-bottom: 8rem;">
                <span class="section-label">Search Results</span>
                <h2 style="font-size: 2.5rem; margin-bottom: 4rem;">Results for "<%= query %>"</h2>
                <div class="card-grid">
                    <% lectures.forEach(function(lecture, index) { %>
                    <a href="/lecture/<%= lecture.id %>/" class="course-card animate-in" style="animation-delay: <%= index * 0.1 %>s">
                        <div class="card-image-wrapper">
                            <% if (lecture.imgUrl) { %>
                            <img src="<%= lecture.imgUrl %>" alt="<%= lecture.title %>">
                            <% } else { %>
                            <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="<%= lecture.title %>">
                            <% } %>
                        </div>
                        <h3 class="card-title"><%= lecture.title %></h3>
                        <p class="card-desc"><%= lecture.description %></p>
                    </a>
                    <% }); %>
                </div>
            </div>
            <% } else { %>
            <div style="margin-bottom: 5rem; text-align: center;">
                <span class="section-label">Explore the Library</span>
                <h2 style="font-size: 3rem; margin-bottom: 4rem;">Scholarly Series</h2>
            </div>
            
            <div class="card-grid" style="margin-bottom: 10rem;">
                <% lectures.forEach(function(lecture, index) { %>
                <a href="/lecture/<%= lecture.id %>/" class="course-card animate-in" style="animation-delay: <%= index * 0.1 %>s">
                    <div class="card-image-wrapper">
                        <% if (lecture.imgUrl) { %>
                        <img src="<%= lecture.imgUrl %>" alt="<%= lecture.title %>">
                        <% } else { %>
                        <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="<%= lecture.title %>">
                        <% } %>
                    </div>
                    <h3 class="card-title"><%= lecture.title %></h3>
                    <p class="card-desc"><%= lecture.description %></p>
                </a>
                <% }); %>
            </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>