<%- include('layout_header') %>

<div style="margin-bottom: 2rem;">
    <a href="/admin/lectures" style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-arrow-left"></i> Back to Lectures
    </a>
    <h1><%= isEdit ? 'Edit' : 'Add' %> Lecture</h1>
</div>

<div class="admin-card">
    <form id="upload-form" action="/admin/lectures/<%= isEdit ? 'edit/' + lecture.id : 'add' %>" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" value="<%= lecture.title || '' %>" required maxlength="50">
        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="5"><%= lecture.description || '' %></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Image</label>
            <% if (lecture.img) { %>
                <div style="margin-bottom: 1rem;">
                    <img src="<%= lecture.img.startsWith('http') ? lecture.img : '/media/' + lecture.img %>" alt="" style="width: 150px; border-radius: 8px; box-shadow: var(--shadow-sm);">
                </div>
            <% } %>
            <input type="file" name="img" class="form-control" accept="image/*">
            <small style="color: var(--text-muted);">Recommended size: 800x600px. Leave empty to keep current image.</small>
        </div>

        <!-- Progress Bar Container -->
        <div id="progress-container" style="display: none; margin-top: 2rem; background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-glass);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span id="progress-status" style="font-weight: 600; color: white;">Uploading image to Cloudinary...</span>
                <span id="progress-percent" style="font-weight: 700; color: var(--primary);">0%</span>
            </div>
            <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;">
                <div id="progress-bar" style="width: 0%; height: 100%; background: var(--primary); transition: width 0.2s ease;"></div>
            </div>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-save"></i> <%= isEdit ? 'Update' : 'Create' %> Lecture
            </button>
            <a href="/admin/lectures" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    function uploadFileToCloudinary(file, resourceType, onProgress) {
        return new Promise((resolve, reject) => {
            fetch('/admin/cloudinary-signature', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => {
                if (!res.ok) throw new Error('Failed to get upload signature');
                return res.json();
            })
            .then(creds => {
                const xhr = new XMLHttpRequest();
                const url = `https://api.cloudinary.com/v1_1/${creds.cloudName}/${resourceType}/upload`;
                
                xhr.open('POST', url, true);
                
                xhr.upload.onprogress = (e) => {
                    if (e.lengthComputable) {
                        const percentComplete = Math.round((e.loaded / e.total) * 100);
                        onProgress(percentComplete);
                    }
                };
                
                xhr.onload = () => {
                    if (xhr.status === 200) {
                        const response = JSON.parse(xhr.responseText);
                        resolve(response.secure_url);
                    } else {
                        reject(new Error('Cloudinary upload failed: ' + xhr.statusText));
                    }
                };
                
                xhr.onerror = () => reject(new Error('Network error during upload'));
                
                const formData = new FormData();
                formData.append('file', file);
                formData.append('api_key', creds.apiKey);
                formData.append('timestamp', creds.timestamp);
                formData.append('signature', creds.signature);
                formData.append('folder', 'alfatwa');
                
                xhr.send(formData);
            })
            .catch(err => reject(err));
        });
    }

    const form = document.getElementById('upload-form');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const imgInput = form.querySelector('input[name="img"]');
        const submitBtn = form.querySelector('button[type="submit"]');
        const imgFile = imgInput && imgInput.files[0];
        
        if (!imgFile) {
            form.submit();
            return;
        }
        
        submitBtn.disabled = true;
        const progressContainer = document.getElementById('progress-container');
        const progressStatus = document.getElementById('progress-status');
        const progressPercent = document.getElementById('progress-percent');
        const progressBar = document.getElementById('progress-bar');
        
        progressContainer.style.display = 'block';
        
        try {
            progressStatus.textContent = 'Uploading Image...';
            const imgUrl = await uploadFileToCloudinary(imgFile, 'image', (pct) => {
                progressPercent.textContent = pct + '%';
                progressBar.style.width = pct + '%';
            });
            
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'img_url';
            hidden.value = imgUrl;
            form.appendChild(hidden);
            
            imgInput.removeAttribute('name');
            
            progressStatus.textContent = 'Finishing...';
            form.submit();
        } catch (err) {
            console.error(err);
            alert('Upload failed: ' + err.message);
            submitBtn.disabled = false;
            progressContainer.style.display = 'none';
        }
    });
</script>

<%- include('layout_footer') %>
