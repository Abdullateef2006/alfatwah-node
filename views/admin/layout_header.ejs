<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Al-Fatwa</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    
    <!-- Global CSS -->
    <link rel="stylesheet" href="/static/css/styles.css">
    
    <style>
        .admin-sidebar {
            background: var(--bg-surface);
            border-right: 1px solid var(--border-glass);
            height: calc(100vh - 72px);
            position: sticky;
            top: 72px;
            padding: 2rem 0;
            z-index: 10;
        }
        .admin-sidebar .nav-item {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            padding: 1rem 2.5rem;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.9rem;
            transition: var(--transition);
        }
        .admin-sidebar .nav-item:hover, .admin-sidebar .nav-item.active {
            background: var(--accent-light);
            color: var(--primary);
            border-right: 4px solid var(--accent);
        }
        .admin-sidebar .nav-item::after { display: none; }

        .admin-container {
            display: grid;
            grid-template-columns: 280px 1fr;
            min-height: calc(100vh - 72px);
        }
        .admin-content {
            padding: 4rem;
            background: rgba(255,255,255,0.4);
            backdrop-filter: blur(10px);
        }
        
        .admin-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background: var(--bg-surface);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: var(--shadow-elite);
            border: 1px solid var(--border-glass);
        }
        .admin-table th {
            background: var(--accent-light);
            padding: 1.5rem;
            text-align: left;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            border-bottom: 1px solid var(--border-glass);
        }
        .admin-table td {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-glass);
            vertical-align: middle;
            font-size: 0.95rem;
        }
        .admin-table tr:last-child td { border-bottom: none; }
        
        .admin-card {
            background: var(--bg-surface);
            padding: 4rem;
            border-radius: 48px;
            box-shadow: var(--shadow-elite);
            border: 1px solid var(--border-glass);
        }
        
        .form-group { margin-bottom: 2rem; }
        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 700;
            color: var(--primary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .form-control {
            width: 100%;
            padding: 1.25rem;
            border-radius: 12px;
            border: 1px solid var(--border-glass);
            background: var(--bg-main);
            font-family: inherit;
            font-size: 1rem;
            transition: var(--transition);
        }
        .form-control:focus {
            outline: none;
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 10px 30px rgba(197, 160, 89, 0.1);
        }
        
        .badge {
            padding: 0.4rem 1rem;
            border-radius: 99px;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .admin-table-container {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin-bottom: 2rem;
            border-radius: 32px;
            box-shadow: var(--shadow-elite);
        }
        
        .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
        
        @media (max-width: 992px) {
            .admin-container { grid-template-columns: 1fr; }
            .admin-sidebar { display: none; }
            .admin-content { padding: 2rem; }
            .admin-header-flex { flex-direction: column; align-items: flex-start !important; gap: 1.5rem; }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container nav-container">
            <a href="/" class="logo-link">
                <i class="fa-solid fa-book-quran"></i>
                <span>Al-Fatwa <small style="font-size: 0.6em; opacity: 0.7;">Admin</small></span>
            </a>
            <div class="nav-links">
                <a href="/" class="nav-item">View Site</a>
                <a href="/admin" class="btn btn-primary">Admin Panel</a>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <aside class="admin-sidebar">
            <nav>
                <a href="/admin" class="nav-item <%= path === '/admin' ? 'active' : '' %>">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>
                <a href="/admin/lectures" class="nav-item <%= path.includes('lectures') ? 'active' : '' %>">
                    <i class="fa-solid fa-chalkboard-user"></i> Lectures
                </a>
            </nav>
        </aside>

        <main class="admin-content">
