<%- include('layout_header') %>

<div style="margin-bottom: 2rem;">
    <a href="/admin/episodes/<%= lecture.id %>" style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-arrow-left"></i> Back to Episodes
    </a>
    <h1><%= isEdit ? 'Edit' : 'Add' %> Episode</h1>
    <p style="color: var(--text-muted);">For lecture: <strong><%= lecture.title %></strong></p>
</div>

<div class="admin-card">
    <form id="upload-form" action="/admin/episodes/<%= isEdit ? 'edit/' + episode.id : lecture.id + '/add' %>" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label class="form-label">Title</label>
            <input type="text" name="title" class="form-control" value="<%= episode.title || '' %>" required maxlength="150">
        </div>

        <div class="form-group">
            <label class="form-label">Video File</label>
            <% if (episode.video) { %>
                <div style="margin-bottom: 0.5rem;">
                    <span class="badge badge-success">Current: <%= episode.video %></span>
                </div>
            <% } %>
            <input type="file" name="video" class="form-control" accept="video/*">
            <small style="color: var(--text-muted);">Leave empty to keep current or if no video.</small>
        </div>

        <div class="form-group">
            <label class="form-label">Audio File</label>
            <% if (episode.audio) { %>
                <div style="margin-bottom: 0.5rem;">
                    <span class="badge badge-success" style="background: #dbeafe; color: #1e40af;">Current: <%= episode.audio %></span>
                </div>
            <% } %>
            <input type="file" name="audio" class="form-control" accept="audio/*">
            <small style="color: var(--text-muted);">Leave empty to keep current or if no audio.</small>
        </div>

        <!-- Progress Bar Container -->
        <div id="progress-container" style="display: none; margin-top: 2rem; background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-glass);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span id="progress-status" style="font-weight: 600; color: white;">Uploading media to Cloudinary...</span>
                <span id="progress-percent" style="font-weight: 700; color: var(--primary);">0%</span>
            </div>
            <div style="width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden;">
                <div id="progress-bar" style="width: 0%; height: 100%; background: var(--primary); transition: width 0.2s ease;"></div>
            </div>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-save"></i> <%= isEdit ? 'Update' : 'Create' %> Episode
            </button>
            <a href="/admin/episodes/<%= lecture.id %>" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    function uploadFileToCloudinary(file, resourceType, onProgress) {
        return new Promise((resolve, reject) => {
            fetch('/admin/cloudinary-signature', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => {
                if (!res.ok) throw new Error('Failed to get upload signature');
                return res.json();
            })
            .then(creds => {
                const xhr = new XMLHttpRequest();
                const url = `https://api.cloudinary.com/v1_1/${creds.cloudName}/${resourceType}/upload`;
                
                xhr.open('POST', url, true);
                
                xhr.upload.onprogress = (e) => {
                    if (e.lengthComputable) {
                        const percentComplete = Math.round((e.loaded / e.total) * 100);
                        onProgress(percentComplete);
                    }
                };
                
                xhr.onload = () => {
                    if (xhr.status === 200) {
                        const response = JSON.parse(xhr.responseText);
                        resolve(response.secure_url);
                    } else {
                        reject(new Error('Cloudinary upload failed: ' + xhr.statusText));
                    }
                };
                
                xhr.onerror = () => reject(new Error('Network error during upload'));
                
                const formData = new FormData();
                formData.append('file', file);
                formData.append('api_key', creds.apiKey);
                formData.append('timestamp', creds.timestamp);
                formData.append('signature', creds.signature);
                formData.append('folder', 'alfatwa');
                
                xhr.send(formData);
            })
            .catch(err => reject(err));
        });
    }

    const form = document.getElementById('upload-form');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const videoInput = form.querySelector('input[name="video"]');
        const audioInput = form.querySelector('input[name="audio"]');
        const submitBtn = form.querySelector('button[type="submit"]');
        
        const videoFile = videoInput && videoInput.files[0];
        const audioFile = audioInput && audioInput.files[0];
        
        if (!videoFile && !audioFile) {
            form.submit();
            return;
        }
        
        submitBtn.disabled = true;
        const progressContainer = document.getElementById('progress-container');
        const progressStatus = document.getElementById('progress-status');
        const progressPercent = document.getElementById('progress-percent');
        const progressBar = document.getElementById('progress-bar');
        
        progressContainer.style.display = 'block';
        
        try {
            if (videoFile) {
                progressStatus.textContent = 'Uploading Video...';
                const videoUrl = await uploadFileToCloudinary(videoFile, 'video', (pct) => {
                    progressPercent.textContent = pct + '%';
                    progressBar.style.width = pct + '%';
                });
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'video_url';
                hidden.value = videoUrl;
                form.appendChild(hidden);
                videoInput.removeAttribute('name');
            }
            
            if (audioFile) {
                progressBar.style.width = '0%';
                progressPercent.textContent = '0%';
                progressStatus.textContent = 'Uploading Audio...';
                const audioUrl = await uploadFileToCloudinary(audioFile, 'video', (pct) => {
                    progressPercent.textContent = pct + '%';
                    progressBar.style.width = pct + '%';
                });
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'audio_url';
                hidden.value = audioUrl;
                form.appendChild(hidden);
                audioInput.removeAttribute('name');
            }
            
            progressStatus.textContent = 'Finishing...';
            form.submit();
        } catch (err) {
            console.error(err);
            alert('Upload failed: ' + err.message);
            submitBtn.disabled = false;
            progressContainer.style.display = 'none';
        }
    });
</script>

<%- include('layout_footer') %>
