<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/static/css/styles.css">
    <title><%= episodes.title %> - <%= episodes.lecture ? episodes.lecture.title : '' %></title>
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <!-- Local overrides if any, otherwise rely on global styles.css -->

        <div class="player-hero animate-in">
            <div class="container">
                <a href="/lecture/<%= episodes.lecture.id %>/" class="lecture-breadcrumb" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; color: var(--primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem;">
                    <i class="fa-solid fa-arrow-left"></i> <%= episodes.lecture.title %>
                </a>
                <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.2; font-weight: 800; margin-bottom: 4rem;"><%= episodes.title %></h1>
                
                <div class="media-box">
                    <% if (episodes.videoUrl) { %>
                    <div class="video-player">
                        <video src="<%= episodes.videoUrl %>" controls></video>
                    </div>
                    <% } %>

                    <% if (episodes.audioUrl) { %>
                    <div class="audio-player-box">
                        <h3><i class="fa-solid fa-volume-high"></i> Audio Transcription</h3>
                        <audio src="<%= episodes.audioUrl %>" controls></audio>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="container animate-in">
            <div class="qa-card">
                <span class="section-label" style="margin-bottom: 2rem;">Common Questions & Answers</span>
                <div class="qa-list">
                    <% if (question.length === 0) { %>
                    <div style="padding: 2rem; text-align: center; color: var(--text-muted);">
                        <i class="fa-solid fa-comment-slash" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                        <p>No questions documented for this episode.</p>
                    </div>
                    <% } else { %>
                    <% question.forEach(function(q) { %>
                    <div class="qa-item">
                        <i class="fa-solid fa-q qa-icon"></i>
                        <div class="qa-text"><%= q.details %></div>
                    </div>
                    <% }); %>
                    <% } %>
                </div>

                <!-- Ask Question Form -->
                <div class="ask-question-form">
                    <h3 class="form-title">
                        <i class="fa-solid fa-pen-fancy" style="color: var(--primary);"></i>
                        Ask a Question
                    </h3>
                    <form method="POST" action="/lectures/episodes/<%= episodes.id %>/">
                        <div class="form-group">
                            <textarea
                                name="question"
                                class="form-control"
                                placeholder="Type your question here about this episode..."
                                required
                            ></textarea>
                        </div>
                        <button type="submit" class="submit-btn">
                            <i class="fa-solid fa-paper-plane"></i>
                            Submit Question
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
