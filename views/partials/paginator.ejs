<style>
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 4rem;
    }
    .pagination-container {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--bg-surface);
        padding: 0.5rem;
        border-radius: 20px;
        border: 1px solid var(--border-glass);
        box-shadow: var(--shadow-elite);
    }
    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 16px;
        color: var(--text-secondary);
        font-weight: 700;
        transition: var(--transition);
        font-size: 0.9rem;
    }
    .page-btn:hover:not([style*="opacity"]) { 
        background: rgba(5, 150, 105, 0.1); 
        color: var(--primary); 
    }
    .page-current {
        font-weight: 800;
        color: white;
        font-size: 0.9rem;
        padding: 0 1.5rem;
        background: var(--bg-main);
        height: 44px;
        display: flex;
        align-items: center;
        border-radius: 12px;
    }
</style>

<div class="pagination-wrapper">
    <div class="pagination-container">
        <% if (page.hasPrevious) { %>
        <a href="<%= baseUrl %>?page=<%= page.previousPageNumber %>" class="page-btn">
            <i class="fa-solid fa-arrow-left"></i> Previous
        </a>
        <% } else { %>
        <span class="page-btn" style="opacity: 0.5; cursor: not-allowed;">
            <i class="fa-solid fa-arrow-left"></i> Previous
        </span>
        <% } %>

        <span class="page-current">Page <%= page.number %> of <%= page.numPages %></span>

        <% if (page.hasNext) { %>
        <a href="<%= baseUrl %>?page=<%= page.nextPageNumber %>" class="page-btn">
            Next <i class="fa-solid fa-arrow-right"></i>
        </a>
        <% } else { %>
        <span class="page-btn" style="opacity: 0.5; cursor: not-allowed;">
            Next <i class="fa-solid fa-arrow-right"></i>
        </span>
        <% } %>
    </div>
</div>
