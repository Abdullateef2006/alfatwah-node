<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/static/css/styles.css">
    <title><%= lecture.title %> - Al-Fatwa</title>
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <!-- Elite Details Layout -->

        <div class="details-hero animate-in">
            <div class="container">
                <a href="/list/" style="color: var(--primary); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem;">
                    <i class="fa-solid fa-arrow-left"></i> Back to Library
                </a>
                <span class="section-label">Lecture Series</span>
                <h1 style="font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1.1; margin-bottom: 1.5rem;"><%= lecture.title %></h1>
                <p style="color: var(--text-secondary); max-width: 700px; font-size: 1.1rem; line-height: 1.7;"><%= lecture.description %></p>
            </div>
        </div>

        <div class="container">
            <div class="episode-list">
                <span class="section-label" style="margin-bottom: 2.5rem;">Series Episodes</span>
                <% if (episodes.length === 0) { %>
                    <p style="color: var(--text-muted); text-align: center; padding: 4rem;">No episodes added to this series yet.</p>
                <% } %>
                <% episodes.forEach(function(ep, index) { %>
                <a href="/lectures/episodes/<%= ep.id %>/" class="episode-link animate-in" style="animation-delay: <%= index * 0.1 %>s">
                    <div>
                        <span class="ep-num">Episode <%= index + 1 %></span>
                        <h3 class="ep-name"><%= ep.title %></h3>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1.5rem;">
                        <span style="color: var(--primary); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em;" class="listen-text">Listen Now</span>
                        <div class="play-icon">
                            <i class="fa-solid fa-play"></i>
                        </div>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
