<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse all Islamic lectures from Al-Fatwa, powered by Sheikh Dhikrullah Shafi'i.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="/static/css/styles.css">
    <title>Lectures List - Al-Fatwa</title>
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <style>
            .list-hero {
                padding: 6rem 0;
                border-bottom: 1px solid var(--border-glass);
                margin-bottom: 5rem;
            }
            .list-hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); margin-top: 1rem; }
        </style>

        <div class="list-hero animate-in">
            <div class="container">
                <span class="section-label">Browse Library</span>
                <h1>Islamic Teachings</h1>
            </div>
        </div>

        <div class="container">
            <div class="card-grid">
                <% if (lecture.items.length === 0) { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 6rem; background: var(--bg-surface); border: 1px solid var(--border-glass); border-radius: 32px;">
                    <i class="fa-solid fa-folder-open" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1.5rem;"></i>
                    <h3>No lectures found</h3>
                    <p style="color: var(--text-secondary); margin-top: 1rem;">We are currently populating this section.</p>
                </div>
                <% } else { %>
                <% lecture.items.forEach(function(lectures, index) { %>
                <a href="/lecture/<%= lectures.id %>/" class="course-card animate-in" style="animation-delay: <%= index * 0.1 %>s">
                    <div class="card-image-wrapper">
                        <% if (lectures.imgUrl) { %>
                        <img src="<%= lectures.imgUrl %>" alt="<%= lectures.title %>">
                        <% } else { %>
                        <img src="/static/img/bc807b5d-dd43-453a-891c-189497072254.png" alt="<%= lectures.title %>">
                        <% } %>
                    </div>
                    <h2 class="card-title"><%= lectures.title %></h2>
                    <p class="card-desc"><%= lectures.description %></p>
                    <div style="margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; padding-top: 1.5rem; border-top: 1px solid var(--border-glass); font-size: 0.85rem; font-weight: 700; color: var(--primary); text-transform: uppercase;">
                        <span>View Series</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>
                <% }); %>
                <% } %>
            </div>

            <!-- Paginator -->
            <div style="margin-top: 4rem; padding-bottom: 2rem;">
                <%- include('partials/paginator', { page: lecture, baseUrl: '/list/' }) %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
